{
  "name": "mechi-safi",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "concurrently -k -n api,worker,web 'pnpm --filter @mechi/api dev' 'pnpm --filter @mechi/worker dev' 'pnpm --filter @mechi/web dev'",
    "dev:all": "pnpm deps:up && pnpm db:migrate && pnpm db:seed && pnpm dev",
    "deps:up": "docker compose up -d --wait postgres redis",
    "deps:down": "docker compose down",
    "db:generate": "pnpm --filter @mechi/database generate",
    "db:migrate": "pnpm --filter @mechi/database migrate",
    "db:seed": "pnpm --filter @mechi/database seed",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@mechi/domain": "workspace:*",
    "@mechi/evaluation": "workspace:*",
    "@mechi/features": "workspace:*",
    "@mechi/football-data": "workspace:*",
    "@mechi/jev": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.7.2",
    "concurrently": "^9.2.1",
    "oxlint": "1.89.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
